# Server-only Google AI Studio key. Never expose a provider key in NEXT_PUBLIC variables.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Development only: do not enable this on a public deployment without real user authentication.
PATHWISE_ALLOW_UNAUTHENTICATED_LIVE_DEMO=false

# Optional Supabase integration boundary. Cross-device sync remains disabled until all are configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
